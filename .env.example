# ─── LLM Provider ────────────────────────────────────────────────────────────
# Required for ranking and summarization
OPENAI_API_KEY=sk-...

# Optional: override model (default: gpt-4o-mini for Stage 1, gpt-4o for Stage 2)
OPENAI_STAGE1_MODEL=gpt-4o-mini
OPENAI_STAGE2_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Podcast Search ───────────────────────────────────────────────────────────
# Podcast Index API (https://api.podcastindex.org)
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# ─── Web Search ───────────────────────────────────────────────────────────────
# Brave Search or Serper.dev key for outside-feed discovery
WEB_SEARCH_API_KEY=
# Provider: brave | serper | none
WEB_SEARCH_PROVIDER=brave

# ─── Optional: Transcription ──────────────────────────────────────────────────
# If set, enables Whisper-based audio transcription (expensive - use carefully)
# WHISPER_API_KEY=   # uses OPENAI_API_KEY if not set separately
ENABLE_AUDIO_TRANSCRIPTION=false

# ─── Cost Controls ────────────────────────────────────────────────────────────
MAX_COST_USD_PER_RUN=2.00
MAX_LLM_TOKENS_PER_RUN=500000

# ─── GitHub Pages base URL (set in CI, optional locally) ─────────────────────
# PAGES_BASE_URL=https://iitiff.github.io/podcast-cpo-scout
