# ─── LLM Provider ────────────────────────────────────────────────────────────
# Required for ranking and summarization
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional: override model (default: gemini-3.6-flash for both stages).
# Gemini free-tier quota is PER MODEL, so switching models is the first
# response to a 429.
GEMINI_STAGE1_MODEL=
GEMINI_STAGE2_MODEL=

# Models to rotate onto when the one above exhausts its DAILY free-tier quota.
# The allowance is per model, so a second model is a second allowance -- and
# rotating beats falling through to a different provider that may have no
# credit. Comma-separated, tried in order; empty keeps single-model behaviour.
# No default chain ships here: a model id this key cannot reach is silently
# useless, so name ones you know the key has access to.
GEMINI_MODEL_FALLBACKS=

# Additional Gemini keys, GEMINI_API_KEY1..9. Quota is per key AND per model,
# so a second key is a second full allowance across every model rather than one
# more model's worth. Keys are tried before a lesser model: a new key restores
# the model you configured, where a new model is a downgrade.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
# Thinking budget. 0 disables thinking (default). 'none' omits the field
# entirely, for a model generation that rejects it.
GEMINI_THINKING_BUDGET=

# ─── Podcast Search ───────────────────────────────────────────────────────────
# Podcast Index API (https://api.podcastindex.org)
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# ─── Web Search ───────────────────────────────────────────────────────────────
# Brave Search or Serper.dev key for outside-feed discovery
WEB_SEARCH_API_KEY=
# Provider: brave | serper | none
WEB_SEARCH_PROVIDER=brave

# ─── Optional: Transcription ──────────────────────────────────────────────────
ENABLE_AUDIO_TRANSCRIPTION=false

# ─── Cost Controls ────────────────────────────────────────────────────────────
MAX_COST_USD_PER_RUN=2.00
MAX_LLM_TOKENS_PER_RUN=500000

# ─── GitHub Pages base URL (set in CI, optional locally) ─────────────────────
# PAGES_BASE_URL=https://iitiff.github.io/podcast-curation-agent

# ─── Email Digest (optional) ──────────────────────────────────────────────────
# Leave SMTP_HOST empty (or unset) to skip the email digest entirely.
#
# Gmail / Google Workspace example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587          (STARTTLS — default)
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-char App Password from https://myaccount.google.com/apppasswords>
#
# SSL/port-465 (e.g. Fastmail, custom SMTP):
#   SMTP_PORT=465
#   SMTP_USE_TLS=false     (switches to SMTP_SSL instead of STARTTLS)
#
# SendGrid / Mailgun example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=<your SendGrid API key>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Who receives the digest (defaults to SMTP_USER if blank)
SMTP_TO=
# Sender address shown in From: header (defaults to SMTP_USER if blank)
SMTP_FROM=
# true = STARTTLS on port 587 (default); false = SSL on port 465
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# Directory layout
# ---------------------------------------------------------------------------
# All optional. Defaults keep the original single-repo behaviour; set them to
# split the engine from a private instance repo (see MIGRATION.md).

CONFIG_DIR=config       # preferences.yaml, shows.yaml, discovery_queries.yaml
DATA_DIR=data           # state.json, history/, feedback.csv
PUBLIC_DIR=public       # generated RSS XML — this is what gets published

# Briefing artifacts (index.html, latest.md, data/latest.json). Defaults to
# PUBLIC_DIR. Set it separately to keep the briefing — which shows scores,
# rejected episodes and synthesis — out of anything published.
# BRIEFING_DIR=briefing

# Durable brain (theses, sources, patterns, companies). Unset disables every
# brain write and the falsifier watch; the pipeline runs exactly as before.
# BRAIN_DIR=brain

# Override the packaged Jinja templates. Normally unset — templates resolve
# from the installed package.
# TEMPLATES_DIR=
